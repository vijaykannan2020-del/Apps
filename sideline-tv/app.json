{
  "expo": {
    "name": "Sideline TV",
    "slug": "sideline-tv",
    "scheme": "sidelinetv",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0d1a",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0d1a"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.vijaykannan.sidelinetv",
      "appleTeamId": "95A592GEVD",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Sideline TV plays streams from your IPTV service.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      "react-native-vlc-media-player",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "55063128-add5-42af-a074-fd30dde687d0"
      }
    },
    "owner": "vijayakannankrishnans-team",
    "runtimeVersion": "2",
    "updates": {
      "url": "https://u.expo.dev/55063128-add5-42af-a074-fd30dde687d0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}