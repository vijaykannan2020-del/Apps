# Copy to .env and fill in.  Never commit .env.
PORT=8787
# Your app's web origin, or * while testing
ALLOWED_ORIGIN=*

# --- USCIS Torch API (developer.uscis.gov) ---
# Sandbox first; switch to production URLs when USCIS grants prod access.
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
USCIS_API_BASE=https://api-int.uscis.gov/case-status
# Cache each receipt this many minutes (USCIS allows ~1,000 calls/day)
CASE_CACHE_MINUTES=180

# --- News ---
# Optional: Anthropic key to write one-line executive summaries of each official notice.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional extra RSS feeds (comma-separated), e.g. USCIS newsroom or DOL OFLC announcement feeds
EXTRA_FEEDS=
NEWS_REFRESH_MINUTES=60

# --- Official data downloads (npm run update-data, runs weekly via deploy/casedesk-data.timer) ---
# Copy the current links from the official pages; they change each year/quarter.
#  Wages:  https://flag.dol.gov/wage-data/wage-data-downloads  (OFLC wage zip for the July–June wage year)
OFLC_WAGES_URL=
OFLC_WAGE_YEAR=2026-27
#  H-1B:   https://www.uscis.gov/tools/reports-and-studies/h-1b-employer-data-hub/h-1b-employer-data-hub-files
H1B_HUB_URLS=
#  PERM / LCA: https://www.dol.gov/agencies/eta/foreign-labor/performance  (Disclosure Data .xlsx)
PERM_URLS=
LCA_URLS=
#  USCIS form statistics (optional override; found automatically): quarterly_all_forms_fyYYYY_qN*.xlsx and
#  i129_quarterly_request_for_evidence_fyYYYY_qN*.xlsx from https://www.uscis.gov/tools/reports-and-studies/immigration-and-citizenship-data
FORM_STATS_URLS=

# --- Unofficial news (Google News search), comma-separated topics ---
NEWS_QUERIES=H-1B visa,L-1 visa,STEM OPT,H-4 EAD,green card visa bulletin,USCIS,prevailing wage H-1B
# Which Visa Bulletin chart USCIS accepts this month for EB I-485s: filing | final  (uscis.gov/visabulletininfo)
USCIS_EB_CHART=filing

# --- Community Q&A (src/forum.mjs) ---
# Long random string (32+ chars) for the moderation endpoints: openssl rand -hex 32. Admin is off when empty.
ADMIN_TOKEN=
# Shown on /support and in the app's Contact moderators sheet
# Optional override; the default comes from deploy.conf (immigrationwallet@gmail.com)
MODERATION_EMAIL=
# Sign in with Apple audience (the app's bundle id)
APPLE_AUDIENCES=com.vijaykannan.casedesk
# Optional: lets account deletion revoke the Apple token (developer.apple.com → Keys → Sign in with Apple)
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY=
# Google sign-in: OAuth client id(s), comma-separated (iOS client). Google sign-in is off when empty. See app/GOOGLE.md
GOOGLE_CLIENT_ID=

# --- Apple Wallet status card (src/wallet.mjs, app/WALLET.md) ---
# Default: nothing to set. The server makes its own key + CSR in data/wallet/ on first start; the
# Wallet certificate workflow (or the owner) puts the public certificate in wallet/pass.cer. Only use
# these to sign with a certificate made elsewhere (P12 base64 + password, or a PEM pair — text or file path).
PASS_TYPE_ID=pass.com.vijaykannan.casedesk
PASS_TEAM_ID=
PASS_CERT_P12=
PASS_CERT_PASSWORD=
PASS_CERT_PEM=
PASS_KEY_PEM=
# Apple WWDR G4 intermediate (PEM). Default: wallet/AppleWWDRCAG4.cer, or downloaded from apple.com on first start.
PASS_WWDR_PEM=
