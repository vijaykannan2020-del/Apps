{
  "expo": {
    "name": "Immigration Wallet",
    "slug": "casedesk",
    "scheme": "casedesk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vijaykannan.casedesk",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Immigration Wallet saves a copy of a document to Photos only when you choose Save Image.",
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Immigration Wallet share",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.vijaykannan.casedesk.share"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.vijaykannan.casedesk.share",
            "UTTypeDescription": "Immigration Wallet share",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "iwshare"
              ],
              "public.mime-type": [
                "application/x-immigration-wallet-share"
              ]
            }
          }
        ]
      },
      "requireFullScreen": false,
      "appleTeamId": "95A592GEVD",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.vijaykannan.casedesk"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDataTypes",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.vijaykannan.casedesk",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Immigration Wallet to use Face ID to unlock your immigration documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Immigration Wallet uses the camera to scan your immigration documents. Text is read on your phone and never uploaded.",
          "photosPermission": "Immigration Wallet lets you pick photos of your immigration documents to store them on this phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5FB497"
        }
      ],
      "expo-background-task",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# PDF text reading (PdfBox-Android) optionally uses a JPEG2000 decoder we do not ship\n-dontwarn com.gemalto.jp2.**\n"
          }
        }
      ],
      "./plugins/withPrivateICloudContainer",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerIdentifier": "iCloud.com.vijaykannan.casedesk",
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/withGoogleSignIn",
      "@bacons/apple-targets"
    ],
    "extra": {
      "apiBase": "https://casedeskapp.duckdns.org",
      "googleIosClientId": "885132086293-472ihidqbu0ki9kst5aav0nqumie3l2g.apps.googleusercontent.com",
      "router": {
        "asyncRoutes": {
          "web": false,
          "default": false
        }
      },
      "eas": {
        "projectId": "1e15ecfc-86cb-4e35-884f-f39c9db7969d"
      }
    },
    "owner": "vijayakannankrishnans-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e15ecfc-86cb-4e35-884f-f39c9db7969d"
    }
  }
}
