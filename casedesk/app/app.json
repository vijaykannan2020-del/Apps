{
  "expo": {
    "name": "Immigration Wallet",
    "slug": "casedesk",
    "scheme": "casedesk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vijaykannan.casedesk",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "requireFullScreen": false,
      "appleTeamId": "95A592GEVD",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.vijaykannan.casedesk"
        ]
      }
    },
    "android": {
      "package": "com.vijaykannan.casedesk",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Immigration Wallet to use Face ID to unlock your immigration documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Immigration Wallet uses the camera to scan your immigration documents. Text is read on your phone and never uploaded.",
          "photosPermission": "Immigration Wallet lets you pick photos of your immigration documents to store them on this phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5FB497"
        }
      ],
      "expo-background-task",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# PDF text reading (PdfBox-Android) optionally uses a JPEG2000 decoder we do not ship\n-dontwarn com.gemalto.jp2.**\n"
          }
        }
      ],
      "./plugins/withPrivateICloudContainer",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerIdentifier": "iCloud.com.vijaykannan.casedesk",
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/withGoogleSignIn",
      "@bacons/apple-targets"
    ],
    "extra": {
      "apiBase": "https://casedeskapp.duckdns.org",
      "googleIosClientId": "885132086293-472ihidqbu0ki9kst5aav0nqumie3l2g.apps.googleusercontent.com",
      "router": {
        "asyncRoutes": {
          "web": false,
          "default": false
        }
      },
      "eas": {
        "projectId": "1e15ecfc-86cb-4e35-884f-f39c9db7969d"
      }
    },
    "owner": "vijayakannankrishnans-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e15ecfc-86cb-4e35-884f-f39c9db7969d"
    }
  }
}
