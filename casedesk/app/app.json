{
  "expo": {
    "name": "CaseDesk",
    "slug": "casedesk",
    "scheme": "casedesk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vijaykannan.casedesk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "requireFullScreen": false
    },
    "android": {
      "package": "com.vijaykannan.casedesk",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CaseDesk to use Face ID to unlock your immigration documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CaseDesk uses the camera to scan your immigration documents. Text is read on your phone and never uploaded.",
          "photosPermission": "CaseDesk lets you pick photos of your immigration documents to store them on this phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A84FF"
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "apiBase": "https://casedeskapp.duckdns.org"
    },
    "owner": "vijayakannankrishnans-team"
  }
}
