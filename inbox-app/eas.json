{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "main",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "RNS_GAMMA_ENABLED": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}