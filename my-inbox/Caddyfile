{$DOMAIN} {
	encode zstd gzip

	handle /_matrix/* {
		reverse_proxy synapse:8008
	}
	handle /push/* {
		reverse_proxy pushgw:8080
	}
	# Forge API (forge/server): coding agents for the Forge app
	handle /forge/* {
		reverse_proxy forge-api:8790
	}
	# Sideline IPTV bridge (sideline/server): plays MAC-locked IPTV for the Sideline app
	handle_path /sideline/* {
		reverse_proxy sideline-api:8791
	}
	handle /_synapse/client/* {
		reverse_proxy synapse:8008
	}
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}
}

# CaseDesk API (casedesk/server). Its own domain, set by casedesk/server/setup.sh in .env as CASEDESK_SITE.
# Until then this is a harmless local-only placeholder.
{$CASEDESK_SITE} {
	encode zstd gzip
	reverse_proxy casedesk-api:8787
}
